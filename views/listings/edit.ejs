```ejs
<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
    <div class="col-lg-8 offset-lg-2">

        <div class="show-info-card">

            <h2 class="mb-4">
                Edit Your Listing
            </h2>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate
                class="needs-validation"
                enctype="multipart/form-data"
            >

                <!-- TITLE -->

                <div class="mb-3">
                    <label class="form-label">
                        Title
                    </label>

                    <input
                        name="listing[title]"
                        value="<%= listing.title %>"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a title
                    </div>
                </div>

                <!-- DESCRIPTION -->

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <textarea
                        name="listing[description]"
                        required
                        class="form-control"
                        rows="5"
                    ><%= listing.description %></textarea>

                    <div class="invalid-feedback">
                        Please enter description
                    </div>
                </div>

                <!-- CURRENT IMAGES -->

                <div class="mb-4">

                    <label class="form-label mb-3">
                        Current Images
                    </label>

                    <div class="d-flex flex-wrap gap-3">

                        <% listing.images.forEach((img) => { %>

                            <img
                                src="<%= img.url %>"
                                class="rounded"
                                loading="lazy"
                                style="
                                    width: 140px;
                                    height: 100px;
                                    object-fit: cover;
                                    border-radius: 14px;
                                    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                                "
                            >

                        <% }) %>

                    </div>

                </div>

                <!-- NEW IMAGES -->

                <div class="mb-4">

                    <label class="form-label">
                        Upload More Images
                    </label>

                    <input
                        name="listing[images]"
                        type="file"
                        class="form-control"
                        multiple
                    >

                </div>

                <!-- PRICE + COUNTRY -->

                <div class="row">

                    <div class="mb-3 col-md-4">

                        <label class="form-label">
                            Price
                        </label>

                        <input
                            name="listing[price]"
                            value="<%= listing.price %>"
                            required
                            type="number"
                            class="form-control"
                        >

                        <div class="invalid-feedback">
                            Please enter price
                        </div>

                    </div>

                    <div class="mb-3 col-md-8">

                        <label class="form-label">
                            Country
                        </label>

                        <input
                            name="listing[country]"
                            value="<%= listing.country %>"
                            type="text"
                            required
                            class="form-control"
                        >

                        <div class="invalid-feedback">
                            Please enter country
                        </div>

                    </div>

                </div>

                <!-- LOCATION -->

                <div class="mb-4">

                    <label class="form-label">
                        Location
                    </label>

                    <input
                        name="listing[location]"
                        value="<%= listing.location %>"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter location
                    </div>

                </div>

                <!-- BUTTON -->

                <button class="edit-btn btn btn-dark">
                    Update Listing
                </button>

            </form>

        </div>

    </div>
</div>
```
