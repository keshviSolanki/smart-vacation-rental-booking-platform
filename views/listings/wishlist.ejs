<% layout("/layouts/boilerplate") %>

<style>

    a{
        text-decoration: none;
        color: black;
    }

    .listing-card{
        border: none !important;
        margin-bottom: 2rem;
    }

    .card-img-top{
        border-radius: 1rem;
        width: 100%;
        object-fit: cover;
    }

    .card-body{
        padding: 0;
    }

    .card-text p{
        font-weight: 400;
    }

</style>

<h2 class="mt-3 mb-4">Your Wishlist ❤️</h2>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

    <% for(let listing of alllistings ) { %>

        <a href="/listings/<%= listing._id %>" class="listing-link">

            <div class="card col listing-card" style="width: 25rem">

                <img 
                    src="<%= listing.images?.[0]?.url || '/images/default.jpg' %>"" 
                    class="card-img-top" 
                    alt="listing-img" 
                    style="height: 20rem"
                    loading="lazy"
                >

                <div class="card-body">

                    <p class="card-text">

                        <b><%= listing.title %></b><br>

                        &#8377; 
                        <%= listing.price.toLocaleString("en-IN") %> /night

                    </p>

                </div>

            </div>

        </a>

    <% } %>

</div>