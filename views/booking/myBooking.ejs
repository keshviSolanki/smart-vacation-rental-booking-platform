<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

  <h2 class="mb-4">My Bookings</h2>

  <!-- FILTER BUTTONS -->
  <div class="d-flex gap-2 flex-wrap mb-3">

    <a href="/bookings/my?status=all"
      class="btn btn-sm <%= activeStatus === 'all' ? 'btn-dark' : 'btn-outline-dark' %>">
      All
    </a>

    <a href="/bookings/my?status=pending"
      class="btn btn-sm <%= activeStatus === 'pending' ? 'btn-warning' : 'btn-outline-warning' %>">
      Pending
    </a>

    <a href="/bookings/my?status=confirmed"
      class="btn btn-sm <%= activeStatus === 'confirmed' ? 'btn-success' : 'btn-outline-success' %>">
      Confirmed
    </a>

    <a href="/bookings/my?status=cancelled"
      class="btn btn-sm <%= activeStatus === 'cancelled' ? 'btn-danger' : 'btn-outline-danger' %>">
      Cancelled
    </a>

    <a href="/bookings/my?status=completed"
      class="btn btn-sm <%= activeStatus === 'completed' ? 'btn-secondary' : 'btn-outline-secondary' %>">
      Completed
    </a>

  </div>

  <% if(bookings.length === 0){ %>
    <div class="alert alert-info">
      No bookings yet.
    </div>
  <% } %>

  <div class="row">

    <% bookings.forEach((booking) => { %>

      <div class="col-md-6 mb-4">

        <div class="card shadow-sm border-0 rounded-4">

          <!-- IMAGE -->
          <img src="<%= booking.listing.images[0].url %>"
               class="card-img-top"
               style="height:250px; object-fit:cover;">

          <div class="card-body">

            <!-- TITLE -->
            <h4><%= booking.listing.title %></h4>

            <!-- STATUS BADGE (FIXED SINGLE SOURCE OF TRUTH) -->
            <p>
              <b>Status:</b>

              <% if(booking.status === "pending"){ %>
                <span class="badge bg-warning">Pending</span>

              <% } else if(booking.status === "confirmed"){ %>
                <span class="badge bg-success">Confirmed</span>

              <% } else if(booking.status === "cancelled"){ %>
                <span class="badge bg-danger">Cancelled</span>

              <% } else { %>
                <span class="badge bg-secondary">Completed</span>
              <% } %>

            </p>

            <!-- DATES -->
            <p>
              <b>Check-In:</b>
              <%= booking.checkIn.toDateString() %>
            </p>

            <p>
              <b>Check-Out:</b>
              <%= booking.checkOut.toDateString() %>
            </p>

            <!-- PRICE -->
            <p>
              <b>Total:</b>
              ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
            </p>

            <!-- CANCEL BUTTON ONLY FOR PENDING -->
            <% if(booking.status === "pending"){ %>

              <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger btn-sm">
                  Cancel Booking
                </button>
              </form>

            <% } %>

          </div>
        </div>

      </div>

    <% }) %>

  </div>
</div>