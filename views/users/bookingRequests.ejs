<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

  <h2>Booking Requests</h2>
  <br>

 <% bookings.forEach(booking => { %>

<div class="booking-card">

  <div class="booking-header">
    <h4><%= booking.listing.title %></h4>
    <span class="status <%= booking.status %>">
      <%= booking.status %>
    </span>
  </div>

  <!-- USER INFO (VISIBLE NOW) -->
  <div class="user-box">

    <p><b>Name:</b> <%= booking.user.username %></p>
    <p><b>Email:</b> <%= booking.user.email %></p>
    <!-- <p><b>User ID:</b> <%= booking.user._id %></p> -->

  </div>

  <!-- BOOKING INFO -->
  <div class="booking-info">

    <div class="info-row">
      <span>Check-in</span>
      <b><%= booking.checkIn.toDateString() %></b>
    </div>

    <div class="info-row">
      <span>Check-out</span>
      <b><%= booking.checkOut.toDateString() %></b>
    </div>

    <div class="info-row">
      <span>Guests</span>
      <b><%= booking.guests %></b>
    </div>

    <div class="info-row highlight">
      <span>Total Amount</span>
      <b>₹<%= booking.totalPrice %></b>
    </div>

  </div>

  <% if(booking.status === "pending") { %>
  <div class="booking-actions">

    <form action="/bookings/<%= booking._id %>/accept?_method=PATCH" method="POST">
      <button class="btn-accept">Accept</button>
    </form>

    <form action="/bookings/<%= booking._id %>/reject?_method=PATCH" method="POST">
      <button class="btn-reject">Reject</button>
    </form>

  </div>
  <% } %>

</div>

<% }) %>

</div>


<style>
  body {
  background: linear-gradient(135deg, #dbeafe, #f0f9ff);
}

/* CARD */
.booking-card {
  background: linear-gradient(135deg, #ffffff, #eef2f7);
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 20px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  transition: 0.3s;
  border-left: 4px solid #6366f1;
}

.booking-card:hover {
  transform: translateY(-5px);
}

/* HEADER */
.booking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* USER BOX */
.user-box {
  margin-top: 10px;
  padding: 10px;
  background: #f1f5ff;
  border-radius: 10px;
  font-size: 14px;
}

/* INFO */
.booking-info {
  margin-top: 10px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid #e5e7eb;
}

/* highlight */
.info-row.highlight b {
  color: #4f46e5;
  font-size: 15px;
}

/* STATUS */
.status {
  padding: 5px 10px;
  border-radius: 20px;
  font-size: 12px;
}

.status.pending { background: #fff7cc; color: #7a5c00; }
.status.accepted { background: #d1fae5; color: #065f46; }
.status.rejected { background: #fee2e2; color: #991b1b; }

/* BUTTONS */
.booking-actions {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.btn-accept {
  background: #22c55e;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 8px;
}

.btn-reject {
  background: #ef4444;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 8px;
} </style>