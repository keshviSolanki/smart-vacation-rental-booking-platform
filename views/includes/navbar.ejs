<style>
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25rem;
    padding: 0 1rem;
  }

  .btn-search:hover {
    border: 2px solid #fe424d;
  }

  .btn-search i {
    display: inline;
    margin-right: 0.75rem;
  }

  .search-input {
    border-radius: 25px;
    padding: 0.5rem 3rem;
    font-size: 0.8rem;
    transition: all 0.2s ease;
  }

  .search-input:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    border-color: #fe424d;
  }

  .wishlist-link {
    text-decoration: none;
    color: #fe424d !important;
    font-weight: 600;
    font-size: 1rem;
    transition: 0.3s;
  }

  .wishlist-link:hover {
    color: #d6333c !important;
  }

  /* SEARCH SUGGESTION BOX */
  #suggestions-box {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    width: 100%;
    background: white;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    z-index: 999;
    max-height: 300px;
    overflow-y: auto;
    backdrop-filter: blur(10px);
    transition: all 0.2s ease;
  }

  .suggestion-item {
    padding: 14px 18px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: #222;
    border-bottom: 1px solid #f1f1f1;
    transition: 0.2s ease;
  }

  .suggestion-item:last-child {
    border-bottom: none;
  }

  .suggestion-item:hover {
    background-color: #f7f7f7;
    color: #fe424d;
    transform: translateX(6px);
  }
</style>

<!-------- THEME CSS ---------->
<link rel="stylesheet" href="/css/theme.css">

<!-------- RAINY HEART THEME CSS ---------->
<link rel="stylesheet" href="/css/rainyheart.css">

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
